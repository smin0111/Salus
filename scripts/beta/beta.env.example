# 맥북 베타 서버용 환경 변수 템플릿입니다.
# 저장소 루트에 .env.beta로 복사해 값을 채웁니다(.env.*는 gitignore 대상이라 올라가지 않습니다).
#   cp scripts/beta/beta.env.example .env.beta
# start-beta.sh는 --env-file .env.beta로만 읽습니다. 로컬 개발용 .env(유튜브 키 등)는 섞이지 않습니다.

# --- 반드시 채울 값 ---------------------------------------------------------
# 비밀번호·키는 새로 만듭니다. 예: openssl rand -base64 48
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=

# Tailscale Funnel 주소(https://기기이름.tailnet이름.ts.net). 로컬 확인용 주소도 함께 둡니다.
# 관리자 화면 출처도 정확히 하나씩 넣습니다: 외부(anywhere) https://<Funnel 주소>:8443, 집 LAN(home) https://<LAN 주소>:8444,
# 서버 본체 http://127.0.0.1:8081·http://localhost:8081. 바꾼 뒤에는 backend를 다시 시작해야 합니다.
APP_CORS_ALLOWED_ORIGINS=https://salus.example.ts.net,http://127.0.0.1:8090,http://localhost:8090,https://salus.example.ts.net:8443,https://192.168.0.10:8444,http://127.0.0.1:8081,http://localhost:8081

# --- 관리자 접근 모드(scripts/beta/admin-access.sh anywhere|home|status) --------
# home 모드에서 관리자 HTTPS를 열 이 맥의 집 LAN 주소 하나(공유기에서 DHCP 예약 권장). 0.0.0.0·대역 표기는 거부합니다.
ADMIN_LAN_BIND_ADDRESS=
ADMIN_LAN_HTTPS_PORT=8444
# LAN 인증서 위치(저장소 밖). scripts/beta/admin-lan-cert.sh가 만들고, 같은 상위 폴더의 ca/ca.crt를 기기에 설치합니다.
ADMIN_LAN_TLS_DIR=~/salus-beta-admin/tls

# 결제: 베타는 포트원 테스트 채널로만 켭니다(실제 청구 없음). 켜려면 아래 네 값이 모두 있어야 결제창이 열립니다.
# PORTONE_WEBHOOK_SECRET은 포트원 콘솔 > 결제 연동 > 웹훅에서 https://<Funnel 주소>/api/payments/webhook 을 등록하고 받은 값입니다.
# 웹훅 시크릿이 비어 있으면 결제 취소를 반영할 수 없어 결제를 받지 않습니다.
PAYMENT_ENABLED=false
PAYMENT_PORTONE_STORE_ID=
PAYMENT_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# 이메일 가입 인증·비밀번호 재설정 메일(Gmail SMTP). Gmail 계정 > 보안 > 2단계 인증 > 앱 비밀번호에서 만든 16자리 값을 넣습니다.
# 비어 있으면 이메일 가입·비밀번호 찾기가 꺼지고(503), 소셜 로그인은 그대로 됩니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=

# --- 소셜 로그인(웹) ----------------------------------------------------------
# 각 개발자 콘솔에 Funnel 주소를 등록해야 로그인됩니다.
#   구글: 웹 클라이언트의 "승인된 자바스크립트 원본"과 "승인된 리디렉션 URI"에 Funnel 주소
#   카카오: 플랫폼 > Web 사이트 도메인, 카카오 로그인 > Redirect URI에 Funnel 주소와 Funnel 주소/api/auth/kakao/callback
#   네이버: 서비스 URL과 Callback URL에 Funnel 주소
OAUTH_GOOGLE_CLIENT_IDS=
OAUTH_KAKAO_APP_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 비어 있으면 카카오 웹 로그인이 꺼집니다(503). 카카오 콘솔 Redirect URI에도 같은 주소를 등록합니다.
KAKAO_WEB_AUTH_CALLBACK_URI=https://salus.example.ts.net/api/auth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 선택 ---------------------------------------------------------------------
# 웹 화면 포트(Funnel이 이 포트로 연결합니다).
WEB_PORT=8090
