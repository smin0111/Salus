# 맥북 베타 서버용 환경 변수 템플릿입니다.
# 저장소 루트에 .env.beta로 복사해 값을 채웁니다(.env.*는 gitignore 대상이라 올라가지 않습니다).
#   cp scripts/beta/beta.env.example .env.beta
# start-beta.sh는 --env-file .env.beta로만 읽습니다. 로컬 개발용 .env(유튜브 키 등)는 섞이지 않습니다.

# --- 반드시 채울 값 ---------------------------------------------------------
# 비밀번호·키는 새로 만듭니다. 예: openssl rand -base64 48
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=

# Tailscale Funnel 주소(https://기기이름.tailnet이름.ts.net). 로컬 확인용 주소도 함께 둡니다.
APP_CORS_ALLOWED_ORIGINS=https://salus.example.ts.net,http://127.0.0.1:8090,http://localhost:8090

# 결제는 베타에서 쓰지 않습니다. compose가 값을 요구해 자리만 채웁니다.
IAMPORT_API_KEY=beta-unused
IAMPORT_API_SECRET=beta-unused

# --- 소셜 로그인(웹) ----------------------------------------------------------
# 각 개발자 콘솔에 Funnel 주소를 등록해야 로그인됩니다.
#   구글: 웹 클라이언트의 "승인된 자바스크립트 원본"과 "승인된 리디렉션 URI"에 Funnel 주소
#   카카오: 플랫폼 > Web 사이트 도메인, 카카오 로그인 > Redirect URI에 Funnel 주소와 Funnel 주소/api/auth/kakao/callback
#   네이버: 서비스 URL과 Callback URL에 Funnel 주소
OAUTH_GOOGLE_CLIENT_IDS=
OAUTH_KAKAO_APP_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 비어 있으면 카카오 웹 로그인이 꺼집니다(503). 카카오 콘솔 Redirect URI에도 같은 주소를 등록합니다.
KAKAO_WEB_AUTH_CALLBACK_URI=https://salus.example.ts.net/api/auth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 선택 ---------------------------------------------------------------------
# 웹 화면 포트(Funnel이 이 포트로 연결합니다).
WEB_PORT=8090
