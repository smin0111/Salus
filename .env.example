# Public template only. Copy to .env and replace placeholders locally.
# Never commit the resulting .env file or any real secret.

MYSQL_DATABASE=mychefai
MYSQL_USER=salus
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# HS256 requires at least 32 bytes. Replace this example before any deployment.
JWT_SECRET=replace-with-at-least-32-byte-random-secret

APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173
APP_TIME_ZONE=Asia/Seoul
APP_ADMIN_IP_WHITELIST_ENABLED=false
APP_ADMIN_ALLOWED_IPS=127.0.0.1,::1
APP_CHAT_RATE_LIMIT_ENABLED=true
APP_CHAT_RATE_LIMIT_GUEST_MAX_REQUESTS_PER_MINUTE=10
APP_CHAT_RATE_LIMIT_AUTHENTICATED_MAX_REQUESTS_PER_MINUTE=60

BACKEND_PORT=8080
ADMIN_PORT=8081
BACKEND_STOP_GRACE_PERIOD=40s
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# Local LLM. For a host Ollama used by Docker, keep host.docker.internal.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma2
OLLAMA_PRIMARY_URL=http://host.docker.internal:11434/api/chat
OLLAMA_SECONDARY_URL=http://host.docker.internal:11435/api/chat

# Optional search and model providers. Empty keys mean not configured.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
GEMINI_API_KEY=

# Recipe Agent and live external evidence providers are opt-in.
MFDS_RECIPE_SOURCE_ENABLED=false
MFDS_RECIPE_API_KEY=
RECIPE_AGENT_ENABLED=false
RECIPE_AGENT_INITIAL_ROUTING_ENABLED=false
RECIPE_AGENT_SOURCE_DISCOVERY_ENABLED=false
RECIPE_AGENT_WEB_SOURCE_ENABLED=false
RECIPE_AGENT_YOUTUBE_SOURCE_ENABLED=false
RECIPE_AGENT_YOUTUBE_TRANSCRIPT_ENABLED=false
RECIPE_AGENT_MEDICATION_INTERACTION_ENABLED=false
RECIPE_AGENT_MEDICATION_LIVE_EVAL_ENABLED=false
RECIPE_AGENT_MFDS_DRUG_PRODUCT_PERMIT_ENABLED=false
RECIPE_AGENT_MFDS_MEDICATION_ENABLED=false
RECIPE_AGENT_OPENFDA_MEDICATION_ENABLED=false
RECIPE_AGENT_RXNORM_ENABLED=false
YOUTUBE_API_KEY=
MFDS_MEDICATION_API_KEY=
OPENFDA_API_KEY=

# PortOne verification is only called from the payment verification flow.
IAMPORT_API_KEY=replace-with-portone-api-key
IAMPORT_API_SECRET=replace-with-portone-api-secret

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
